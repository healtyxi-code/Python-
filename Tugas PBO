"""
Tugas Mandiri OOP Python - Sistem Penggajian Karyawan (Payroll System)
Materi: Class, Encapsulation, Inheritance, Polymorphism
"""


class Karyawan:
    """Superclass untuk semua jenis karyawan."""

    def __init__(self, nama, id_karyawan, gaji_pokok):
        self.nama = nama                    # public
        self.id_karyawan = id_karyawan      # public
        self.__gaji_pokok = 0               # private
        self.gaji_pokok = gaji_pokok        # lewat setter agar tervalidasi

    # ---------- Getter & Setter (Encapsulation) ----------
    @property
    def gaji_pokok(self):
        return self.__gaji_pokok

    @gaji_pokok.setter
    def gaji_pokok(self, nilai):
        if nilai <= 0:
            print(f"[PERINGATAN] Gaji pokok tidak valid ({nilai}). "
                  f"Nilai harus lebih dari 0. Gaji pokok tidak diubah.")
        else:
            self.__gaji_pokok = nilai

    # ---------- Method ----------
    def hitung_gaji_total(self):
        return self.__gaji_pokok

    def tampilkan_info(self):
        print(f"Nama          : {self.nama}")
        print(f"ID Karyawan   : {self.id_karyawan}")
        print(f"Gaji Pokok    : Rp{self.__gaji_pokok:,.0f}")


class KaryawanTetap(Karyawan):
    """Karyawan tetap: gaji pokok + tunjangan jabatan."""

    def __init__(self, nama, id_karyawan, gaji_pokok, tunjangan):
        super().__init__(nama, id_karyawan, gaji_pokok)
        self.tunjangan = tunjangan

    def hitung_gaji_total(self):  # Overriding
        return self.gaji_pokok + self.tunjangan

    def tampilkan_info(self):  # Overriding
        print("--- Karyawan Tetap ---")
        super().tampilkan_info()
        print(f"Tunjangan     : Rp{self.tunjangan:,.0f}")
        print(f"Total Gaji    : Rp{self.hitung_gaji_total():,.0f}")


class KaryawanKontrak(Karyawan):
    """Karyawan kontrak: gaji pokok + (jam lembur x tarif lembur)."""

    def __init__(self, nama, id_karyawan, gaji_pokok, jam_lembur, tarif_lembur):
        super().__init__(nama, id_karyawan, gaji_pokok)
        self.jam_lembur = jam_lembur
        self.tarif_lembur = tarif_lembur

    def hitung_gaji_total(self):  # Overriding
        return self.gaji_pokok + (self.jam_lembur * self.tarif_lembur)

    def tampilkan_info(self):  # Overriding
        print("--- Karyawan Kontrak ---")
        super().tampilkan_info()
        print(f"Jam Lembur    : {self.jam_lembur} jam")
        print(f"Tarif Lembur  : Rp{self.tarif_lembur:,.0f}/jam")
        print(f"Total Lembur  : Rp{self.jam_lembur * self.tarif_lembur:,.0f}")
        print(f"Total Gaji    : Rp{self.hitung_gaji_total():,.0f}")


# ======================= MAIN PROGRAM =======================
if __name__ == "__main__":
    # 1. Buat objek
    tetap = KaryawanTetap("Budi Santoso", "KT-001", 7_000_000, 1_500_000)
    kontrak = KaryawanKontrak("Siti Aminah", "KK-001", 4_500_000, 20, 50_000)

    # 2. Simpan dalam list
    daftar_karyawan = [tetap, kontrak]

    # 3. Polymorphism: method yang sama, perilaku berbeda
    print("=" * 40)
    print("DAFTAR KARYAWAN (POLYMORPHISM)")
    print("=" * 40)
    for k in daftar_karyawan:
        k.tampilkan_info()
        print()

    # 4. Encapsulation: ubah gaji pokok
    print("=" * 40)
    print("DEMO ENCAPSULATION")
    print("=" * 40)

    print("Mengubah gaji pokok Budi dengan nilai tidak valid (-1000)...")
    tetap.gaji_pokok = -1000

    print("\nMengubah gaji pokok Budi dengan nilai valid (8.000.000)...")
    tetap.gaji_pokok = 8_000_000

    print("\nData setelah perubahan:")
    tetap.tampilkan_info()
